    "@qdrant/js-client-rest": "^1.13.0",
    "bullmq": "^5.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.6.0",
    "langfuse": "^3.37.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
